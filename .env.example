# TBC Website — environment variables
# Copy to .env for local development, or set these in Vercel → Settings → Environment Variables.
#
# NOTE: On the Vercel deployment these are created AUTOMATICALLY by the
# Neon Marketplace integration (vercel install neon). You normally never
# edit them by hand.

# 1) PostgreSQL (REQUIRED)
#    Runtime (Prisma + PgBouncer pooling) — preferred by src/lib/db.ts:
POSTGRES_PRISMA_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=10

#    Generic pooled URL (also set by the Neon integration):
POSTGRES_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

#    Non-pooled / direct URL — use ONLY for `prisma db push` / migrations:
#    POSTGRES_URL_NON_POOLING=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# 2) Vercel Blob storage (photos) — auto-set when the Blob store is
#    connected to the project. Without it, uploads fall back to local disk
#    (fine for local dev, NOT persistent on Vercel).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# 3) WhatsApp Cloud API (OPTIONAL — auto-send admin password reset codes)
#    Without it, the reset flow generates a wa.me link so the admin can
#    self-send the code to their own WhatsApp. Can also be configured later
#    from Admin Panel → Settings.
# WHATSAPP_API_URL=https://graph.facebook.com/v21.0/<PHONE_NUMBER_ID>/messages
# WHATSAPP_API_TOKEN=EAAG...

# ---- Local sandbox development only ----
# POSTGRES_URL=postgresql://tbcadmin:tbclocal123@127.0.0.1:5432/tbc
